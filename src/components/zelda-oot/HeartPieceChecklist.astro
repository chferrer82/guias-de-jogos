---
import Checklist from '../Checklist.astro';
import { heartPieces } from '../../data/zelda-oot/collectibles';

const ages = [
	{ key: 'criança', title: 'Quando criança' },
	{ key: 'ambas', title: 'Criança ou adulto' },
	{ key: 'adulto', title: 'Quando adulto' },
] as const;

const groups = ages.map((age) => ({
	title: age.title,
	items: heartPieces
		.filter((p) => p.age === age.key)
		.map((p) => ({ id: p.id, title: p.region, body: p.how })),
}));
---

<Checklist storageKey="zelda-oot:heart-pieces" idPrefix="peca" unit="Peças" groups={groups} />
